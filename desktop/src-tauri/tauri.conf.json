{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SchoolSchedule",
  "version": "0.1.1",
  "identifier": "kr.hs.gwe.chunchon.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "학교 일정",
        "width": 380,
        "height": 520,
        "minWidth": 280,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1QTFBRjk0MTA1MzBEOTgKUldTWURWTVFsSytoTllQK0FoUGlDbUJpa1RqV0F3U04vMkRsK25vSkd3a2pJTG9uWWxIS3RZVCsK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
