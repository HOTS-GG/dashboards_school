{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SchoolSchedule",
  "version": "0.1.0",
  "identifier": "kr.hs.gwe.chunchon.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "학교 일정",
        "width": 380,
        "height": 520,
        "minWidth": 280,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
